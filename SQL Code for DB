-- INSERT Health Record
CREATE PROCEDURE AddHealthRecord
    @RECORDID          INT,
    @TAGID             INT,
    @TREATMENTDATE     DATE,
    @DIAGNOSIS         VARCHAR(100),
    @MEDICATIONS       VARCHAR(100),
    @MEDICATION_DOSAGE VARCHAR(45),
    @STAFF_MEMBER      VARCHAR(40),
    @NOTES             VARCHAR(255)
AS
BEGIN
    BEGIN TRY
        -- Check if RECORDID already exists
        IF EXISTS (SELECT 1 FROM HealthManager WHERE RECORDID = @RECORDID)
        BEGIN
            RAISERROR('A record with this RECORDID already exists.', 16, 1);
            RETURN;
        END

        -- Check if TAGID exists in ANIMALS
        IF NOT EXISTS (SELECT 1 FROM ANIMALS WHERE TAGID = @TAGID)
        BEGIN
            RAISERROR('This TAGID does not exist in ANIMALS table.', 16, 1);
            RETURN;
        END

        -- Check if date is valid
        IF @TREATMENTDATE > GETDATE()
        BEGIN
            RAISERROR('Treatment date cannot be in the future.', 16, 1);
            RETURN;
        END;

        -- Insert the record
        INSERT INTO HealthManager (
            RECORDID,
            TAGID,
            TREATMENTDATE,
            DIAGNOSIS,
            MEDICATIONS,
            MEDICATION_DOSAGE,
            STAFF_MEMBER,
            NOTES
        )
        VALUES (
            @RECORDID,
            @TAGID,
            @TREATMENTDATE,
            @DIAGNOSIS,
            @MEDICATIONS,
            @MEDICATION_DOSAGE,
            @STAFF_MEMBER,
            @NOTES
        );

        PRINT 'Health record added successfully.';

    END TRY
    BEGIN CATCH
        PRINT 'ERROR: '        + ERROR_MESSAGE();
        PRINT 'Error Number: ' + CAST(ERROR_NUMBER() AS VARCHAR);
        PRINT 'Error Line: '   + CAST(ERROR_LINE()   AS VARCHAR);
    END CATCH
END;
GO

