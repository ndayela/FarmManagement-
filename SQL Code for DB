    SELECT
        h.RECORDID,
        h.TAGID,
        a.BREED,
        a.STATE         AS ANIMAL_STATE,
        h.TREATMENTDATE,
        h.DIAGNOSIS,
        h.MEDICATIONS,
        h.MEDICATION_DOSAGE,
        h.STAFF_MEMBER,
        h.NOTES,
        CASE
            WHEN a.STATE = 'Healthy'  THEN ' Healthy'
            WHEN a.STATE = 'Sick'     THEN ' Needs Attention'
