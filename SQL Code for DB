CREATE DATABASE Farm_System;
USE Farm_System;
GO

CREATE TABLE ANIMALS(
TAGID INT PRIMARY KEY,
BREED VARCHAR(45) NOT NULL,
GENDER CHAR NOT NULL,
STATE VARCHAR(60) NOT NULL
);

CREATE TABLE CATTLE(
TAGID INT PRIMARY KEY,
BREED VARCHAR(45) NOT NULL,
GENDER CHAR NOT NULL,
STATE VARCHAR(60) NOT NULL
FOREIGN KEY (TAGID) REFERENCES ANIMALS(TAGID)
);

CREATE TABLE SHEEP(
TAGID INT PRIMARY KEY,
BREED VARCHAR(45) NOT NULL,
GENDER CHAR NOT NULL,
STATE VARCHAR(60) NOT NULL
FOREIGN KEY (TAGID) REFERENCES ANIMALS(TAGID)
);

CREATE TABLE POULTRY(
TAGID INT PRIMARY KEY,
BREED VARCHAR(45) NOT NULL,
GENDER CHAR NOT NULL,
STATE VARCHAR(60) NOT NULL
FOREIGN KEY (TAGID) REFERENCES ANIMALS(TAGID)
);

CREATE TABLE MedicalRecords (
    RECORDID         INT PRIMARY KEY,
    TAGID            INT,
    TREATMENTDATE    DATE,
    DIAGNOSIS        VARCHAR(100),
    MEDICATIONS      VARCHAR(100),
    MEDICATION_DOSAGE VARCHAR(45),
    STAFF_MEMBER     VARCHAR(40),
    NOTES            VARCHAR(255),
    FOREIGN KEY (TAGID) REFERENCES ANIMALS(TAGID)
);

CREATE TABLE HealthManager(
    RECORDID         INT PRIMARY KEY,
    TAGID            INT,
    TREATMENTDATE    DATE,
    DIAGNOSIS        VARCHAR(100),
    MEDICATIONS      VARCHAR(100),
    MEDICATION_DOSAGE VARCHAR(45),
    STAFF_MEMBER     VARCHAR(40),
    NOTES            VARCHAR(255),
    FOREIGN KEY (TAGID) REFERENCES ANIMALS(TAGID)
);

CREATE TABLE StockItem (
    ITEMID        INT PRIMARY KEY,
    ITEM_NAME     VARCHAR(100),
    CATEGORY      VARCHAR(50),
    QUANTITY      DECIMAL(10, 2),
    UNIT          VARCHAR(10),
    REORDER_LEVEL DECIMAL(10, 2)
);

CREATE TABLE INVENTORY_MANAGER(
ITEMID INT PRIMARY KEY,
ITEM_NAME VARCHAR(100),
CATEGORY VARCHAR(50),
QUANTITY DECIMAL(10,2),
UNIT VARCHAR (10),
REORDER_LEVEL DECIMAL(10,2)
 FOREIGN KEY (ITEMID) REFERENCES StockItem(ITEMID)
);


