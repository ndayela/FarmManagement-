-- PROCEDURE: Display a single item by ITEMID
CREATE PROCEDURE GetInventoryByID
    @ITEMID INT
AS
BEGIN
    BEGIN TRY

        IF NOT EXISTS (SELECT 1 FROM INVENTORY_MANAGER WHERE ITEMID = @ITEMID)
        BEGIN
            RAISERROR('Item not found in Inventory.', 16, 1);
            RETURN;
        END

        SELECT * FROM InventoryStatus WHERE ITEMID = @ITEMID;

    END TRY
    BEGIN CATCH
        PRINT 'ERROR: '        + ERROR_MESSAGE();
        PRINT 'Error Number: ' + CAST(ERROR_NUMBER() AS VARCHAR);
        PRINT 'Error Line: '   + CAST(ERROR_LINE()   AS VARCHAR);
    END CATCH
END;
GO

-- PROCEDURE: Display only LOW STOCK items
CREATE PROCEDURE GetLowStockItems
AS
BEGIN
    BEGIN TRY

        IF NOT EXISTS (
            SELECT 1 FROM INVENTORY_MANAGER
            WHERE QUANTITY <= REORDER_LEVEL
        )
        BEGIN
            RAISERROR('No low stock items found.', 16, 1);
            RETURN;
        END

        SELECT * FROM InventoryStatus
        WHERE STOCK_STATUS = ' LOW STOCK'
           OR STOCK_STATUS = ' OUT OF STOCK';

    END TRY
    BEGIN CATCH
        PRINT 'ERROR: '        + ERROR_MESSAGE();
        PRINT 'Error Number: ' + CAST(ERROR_NUMBER() AS VARCHAR);
        PRINT 'Error Line: '   + CAST(ERROR_LINE()   AS VARCHAR);
    END CATCH
END;
GO

CREATE PROCEDURE CursorAllInventory
AS
BEGIN
    BEGIN TRY
        DECLARE @ITEMID       INT;
        DECLARE @ITEM_NAME    VARCHAR(100);
        DECLARE @QUANTITY     DECIMAL(10,2);
        DECLARE @REORDER_LEVEL DECIMAL(10,2);
        DECLARE @UNIT         VARCHAR(10);

        DECLARE cursor_inventory CURSOR FOR
            SELECT ITEMID, ITEM_NAME, QUANTITY, REORDER_LEVEL, UNIT
            FROM INVENTORY_MANAGER;

        OPEN cursor_inventory;
        FETCH NEXT FROM cursor_inventory
        INTO @ITEMID, @ITEM_NAME, @QUANTITY, @REORDER_LEVEL, @UNIT;

        WHILE @@FETCH_STATUS = 0
        BEGIN
            PRINT 'ItemID: '    + CAST(@ITEMID    AS VARCHAR) +
                  ' | Name: '   + @ITEM_NAME                 +
                  ' | Qty: '    + CAST(@QUANTITY   AS VARCHAR) +
                  ' | Unit: '   + @UNIT                       +
                  ' | Reorder: '+ CAST(@REORDER_LEVEL AS VARCHAR);

            FETCH NEXT FROM cursor_inventory
            INTO @ITEMID, @ITEM_NAME, @QUANTITY, @REORDER_LEVEL, @UNIT;
        END;

        CLOSE cursor_inventory;
        DEALLOCATE cursor_inventory;

    END TRY
    BEGIN CATCH
        CLOSE cursor_inventory;
        DEALLOCATE cursor_inventory;
        PRINT 'CURSOR ERROR: ' + ERROR_MESSAGE();
    END CATCH
END;
GO

CREATE FUNCTION CheckInventoryStock(@ITEMID INT)
RETURNS DECIMAL(10,2)
AS
BEGIN
    DECLARE @QTY DECIMAL(10,2);

    IF NOT EXISTS (SELECT 1 FROM INVENTORY_MANAGER WHERE ITEMID = @ITEMID)
        RETURN -1;

    SELECT @QTY = QUANTITY
    FROM INVENTORY_MANAGER
    WHERE ITEMID = @ITEMID;

    RETURN @QTY;
END;
GO

