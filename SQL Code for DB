-- ADD STOCK
CREATE PROCEDURE AddStock
    @ITEMID   INT,
    @QUANTITY DECIMAL(10,2)
AS
BEGIN
    UPDATE StockItem
    SET QUANTITY = QUANTITY + @QUANTITY
    WHERE ITEMID = @ITEMID;

    PRINT 'Stock added successfully';
END;
GO

-- SUBTRACT STOCK
CREATE PROCEDURE SubtractStock
    @ITEMID   INT,
    @QUANTITY DECIMAL(10,2)
AS
BEGIN
    -- Check if enough stock exists first
    IF (SELECT QUANTITY FROM StockItem WHERE ITEMID = @ITEMID) < @QUANTITY
    BEGIN
        RAISERROR('Not enough stock available.', 16, 1);
        RETURN;
    END

    UPDATE StockItem
    SET QUANTITY = QUANTITY - @QUANTITY
    WHERE ITEMID = @ITEMID;

    PRINT 'Stock subtracted successfully';
END;
GO

-- TRIGGER: Check stock after every update
CREATE TRIGGER trg_CheckReorderLevel
ON StockItem
AFTER UPDATE
AS
BEGIN
    IF EXISTS (
        SELECT 1 FROM inserted
        WHERE QUANTITY <= REORDER_LEVEL
    )
    BEGIN
        RAISERROR('WARNING: Stock has fallen below reorder level!', 16, 1);
    END
END;
GO

--TRANSACTION--
CREATE PROCEDURE SafeSubtractStock
    @ITEMID   INT,
    @QUANTITY DECIMAL(10,2)
AS
BEGIN
    BEGIN TRANSACTION;
        IF (SELECT QUANTITY FROM StockItem WHERE ITEMID = @ITEMID) < @QUANTITY
        BEGIN
            RAISERROR('Not enough stock available.', 16, 1);
            ROLLBACK TRANSACTION;
            RETURN;
        END

        UPDATE StockItem
        SET QUANTITY = QUANTITY - @QUANTITY
        WHERE ITEMID = @ITEMID;

    COMMIT TRANSACTION;
    PRINT 'Stock safely subtracted';
END;
GO

--DISPLAYING
CREATE VIEW StockStatus AS
    SELECT
        ITEMID,
        ITEM_NAME,
        CATEGORY,
        QUANTITY,
        UNIT,
        REORDER_LEVEL,
        CASE
            WHEN QUANTITY <= REORDER_LEVEL THEN ' LOW STOCK'
            ELSE ' STOCK OK'
        END AS STOCK_STATUS
    FROM StockItem;
