CREATE PROCEDURE CursorAllTreatedAnimals
AS
BEGIN
    BEGIN TRY
        DECLARE @TAGID        INT;
        DECLARE @DIAGNOSIS    VARCHAR(100);
        DECLARE @STAFF_MEMBER VARCHAR(40);
        DECLARE @TREATMENTDATE DATE;

        DECLARE cursor_health CURSOR FOR
            SELECT TAGID, DIAGNOSIS, STAFF_MEMBER, TREATMENTDATE
            FROM HealthManager;

        OPEN cursor_health;
        FETCH NEXT FROM cursor_health
        INTO @TAGID, @DIAGNOSIS, @STAFF_MEMBER, @TREATMENTDATE;

        WHILE @@FETCH_STATUS = 0
        BEGIN
            PRINT 'TAGID: '      + CAST(@TAGID AS VARCHAR) +
                  ' | Diagnosis: ' + @DIAGNOSIS +
                  ' | Staff: '     + @STAFF_MEMBER +
                  ' | Date: '      + CAST(@TREATMENTDATE AS VARCHAR);

            FETCH NEXT FROM cursor_health
            INTO @TAGID, @DIAGNOSIS, @STAFF_MEMBER, @TREATMENTDATE;
        END;

        CLOSE cursor_health;
        DEALLOCATE cursor_health;

    END TRY
    BEGIN CATCH
        CLOSE cursor_health;
        DEALLOCATE cursor_health;
        PRINT 'CURSOR ERROR: ' + ERROR_MESSAGE();
    END CATCH
END;
GO


-- UPDATE Stock Quantity
CREATE PROCEDURE UpdateInventoryStock
    @ITEMID   INT,
    @QUANTITY DECIMAL(10,2)
AS
BEGIN
    BEGIN TRY
        BEGIN TRANSACTION;

            -- Check if item exists in StockItem
            IF NOT EXISTS (SELECT 1 FROM StockItem WHERE ITEMID = @ITEMID)
            BEGIN
                RAISERROR('Item does not exist in StockItem table.', 16, 1);
                ROLLBACK TRANSACTION;
                RETURN;
            END

            -- Check if item exists in INVENTORY_MANAGER
            IF NOT EXISTS (SELECT 1 FROM INVENTORY_MANAGER WHERE ITEMID = @ITEMID)
            BEGIN
                RAISERROR('Item does not exist in INVENTORY_MANAGER table.', 16, 1);
                ROLLBACK TRANSACTION;
                RETURN;
            END

            -- Check if quantity is valid
            IF @QUANTITY < 0
            BEGIN
                RAISERROR('Quantity cannot be negative.', 16, 1);
                ROLLBACK TRANSACTION;
                RETURN;
            END

            -- Update INVENTORY_MANAGER
            UPDATE INVENTORY_MANAGER
            SET QUANTITY = @QUANTITY
            WHERE ITEMID = @ITEMID;

            -- Update StockItem as well to keep both in sync
            UPDATE StockItem
            SET QUANTITY = @QUANTITY
            WHERE ITEMID = @ITEMID;

        COMMIT TRANSACTION;
        PRINT 'Inventory stock updated successfully.';

    END TRY
    BEGIN CATCH
        IF @@TRANCOUNT > 0
            ROLLBACK TRANSACTION;

        PRINT 'TRANSACTION FAILED!';
        PRINT 'ERROR: '        + ERROR_MESSAGE();
        PRINT 'Error Number: ' + CAST(ERROR_NUMBER() AS VARCHAR);
        PRINT 'Error Line: '   + CAST(ERROR_LINE()   AS VARCHAR);
    END CATCH
END;
GO

-- ADD Stock to existing quantity
CREATE PROCEDURE AddInventoryStock
    @ITEMID   INT,
    @QUANTITY DECIMAL(10,2)
AS
BEGIN
    BEGIN TRY
        BEGIN TRANSACTION;

            -- Check if item exists
            IF NOT EXISTS (SELECT 1 FROM INVENTORY_MANAGER WHERE ITEMID = @ITEMID)
            BEGIN
                RAISERROR('Item does not exist in INVENTORY_MANAGER.', 16, 1);
                ROLLBACK TRANSACTION;
                RETURN;
            END

            -- Check if quantity is valid
            IF @QUANTITY <= 0
            BEGIN
                RAISERROR('Quantity must be greater than zero.', 16, 1);
                ROLLBACK TRANSACTION;
                RETURN;
            END

            -- Add to INVENTORY_MANAGER
            UPDATE INVENTORY_MANAGER
            SET QUANTITY = QUANTITY + @QUANTITY
            WHERE ITEMID = @ITEMID;

            -- Keep StockItem in sync
            UPDATE StockItem
            SET QUANTITY = QUANTITY + @QUANTITY
            WHERE ITEMID = @ITEMID;

        COMMIT TRANSACTION;
        PRINT 'Stock added to inventory successfully.';

    END TRY
    BEGIN CATCH
        IF @@TRANCOUNT > 0
            ROLLBACK TRANSACTION;

        PRINT 'TRANSACTION FAILED!';
        PRINT 'ERROR: '        + ERROR_MESSAGE();
        PRINT 'Error Number: ' + CAST(ERROR_NUMBER() AS VARCHAR);
        PRINT 'Error Line: '   + CAST(ERROR_LINE()   AS VARCHAR);
    END CATCH
END;
GO

-- SUBTRACT Stock from existing quantity
CREATE PROCEDURE SubtractInventoryStock
    @ITEMID   INT,
    @QUANTITY DECIMAL(10,2)
AS
BEGIN
    BEGIN TRY
        BEGIN TRANSACTION;

            -- Check if item exists
            IF NOT EXISTS (SELECT 1 FROM INVENTORY_MANAGER WHERE ITEMID = @ITEMID)
            BEGIN
                RAISERROR('Item does not exist in INVENTORY_MANAGER.', 16, 1);
                ROLLBACK TRANSACTION;
                RETURN;
            END

            -- Check if quantity is valid
            IF @QUANTITY <= 0
            BEGIN
                RAISERROR('Quantity must be greater than zero.', 16, 1);
                ROLLBACK TRANSACTION;
                RETURN;
            END

            -- Check if enough stock exists
            IF (SELECT QUANTITY FROM INVENTORY_MANAGER WHERE ITEMID = @ITEMID) < @QUANTITY
            BEGIN
                RAISERROR('Not enough stock available.', 16, 1);
                ROLLBACK TRANSACTION;
                RETURN;
            END

            -- Subtract from INVENTORY_MANAGER
            UPDATE INVENTORY_MANAGER
            SET QUANTITY = QUANTITY - @QUANTITY
            WHERE ITEMID = @ITEMID;

            -- Keep StockItem in sync
            UPDATE StockItem
            SET QUANTITY = QUANTITY - @QUANTITY
            WHERE ITEMID = @ITEMID;

        COMMIT TRANSACTION;
        PRINT 'Stock subtracted from inventory successfully.';

    END TRY
    BEGIN CATCH
        IF @@TRANCOUNT > 0
            ROLLBACK TRANSACTION;

        PRINT 'TRANSACTION FAILED!';
        PRINT 'ERROR: '        + ERROR_MESSAGE();
        PRINT 'Error Number: ' + CAST(ERROR_NUMBER() AS VARCHAR);
        PRINT 'Error Line: '   + CAST(ERROR_LINE()   AS VARCHAR);
    END CATCH
END;
GO


-- VIEW: Display all inventory with stock status
CREATE VIEW InventoryStatus AS
    SELECT
        i.ITEMID,
        i.ITEM_NAME,
        i.CATEGORY,
        i.QUANTITY,
        i.UNIT,
        i.REORDER_LEVEL,
        CASE
            WHEN i.QUANTITY <= 0              THEN ' OUT OF STOCK'
            WHEN i.QUANTITY <= i.REORDER_LEVEL THEN ' LOW STOCK'
            ELSE                                   'STOCK OK'
        END AS STOCK_STATUS
    FROM INVENTORY_MANAGER i;
GO

